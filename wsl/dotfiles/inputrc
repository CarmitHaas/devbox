# ~/.inputrc: readline for bash (and python, psql, anything using readline)
$include /etc/inputrc

# completion
set completion-ignore-case on
set completion-map-case on
set show-all-if-ambiguous on
set show-all-if-unmodified on
set menu-complete-display-prefix on
set colored-stats on
set colored-completion-prefix on
set visible-stats on
set mark-symlinked-directories on
set skip-completed-text on
set completion-query-items 200
set page-completions off

# behaviour
set bell-style none
set editing-mode emacs
set enable-bracketed-paste on
set echo-control-characters off

# Up/Down search history for what you already typed
"\e[A": history-search-backward
"\e[B": history-search-forward
"\eOA": history-search-backward
"\eOB": history-search-forward

# Ctrl+Left / Ctrl+Right move by word
"\e[1;5C": forward-word
"\e[1;5D": backward-word
# Ctrl+Delete deletes the word ahead
"\e[3;5~": kill-word
# Ctrl+Backspace deletes the word behind (Windows Terminal sends ^H for it, 0x7f for Backspace)
"\C-h": backward-kill-word

# Tab cycles through matches once the common prefix is shown; Shift+Tab goes back
TAB: menu-complete
"\e[Z": menu-complete-backward
